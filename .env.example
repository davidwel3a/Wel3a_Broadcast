# ==============================================================================
# Environment Configuration Template
# Duplicate this file to .env.local and populate with your own project keys.
# Never commit real credentials or production secrets to version control.
# ==============================================================================

# Database Connection (PostgreSQL - Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/broadcast_bot?sslmode=require"

# Application Encryption Key (Must be 32 bytes hex encoded for AES-256-GCM)
# Generate using: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=""

# Discord OAuth2 Application Credentials (From https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback/discord"

# Authorization Gate (Discord Server & Role ID required to access dashboard)
REQUIRED_DISCORD_GUILD_ID=""
REQUIRED_DISCORD_ROLE_ID=""

# Session Secret (For secure http-only session cookies)
# Generate using: openssl rand -hex 32
SESSION_SECRET=""

# Redis Queue Connection (For BullMQ background workers - e.g. Upstash Redis)
REDIS_URL="redis://default:password@localhost:6379"

# Web Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
